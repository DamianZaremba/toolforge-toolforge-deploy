chartVersion: 0.0.227-20261108162653-77edb3a7
chartRepository: toolsbeta
replicas: 1

image:
  pullPolicy: Always

config:
  debug: true
  # You can override this by exporting the env var HARBOR_HOSTNAME before running ./depoy.sh
  harborRepository: http://harbor.local
  okBuildsToKeep: 1
  failedBuildsToKeep: 2
  harborUsername: "robot$maintain-harbor"
  harborPassword: "Dummyr0botpass"

  # make sure all tags below are different, because https://phabricator.wikimedia.org/T442364
  builder:           tools-harbor.wmcloud.org/toolforge/heroku-builder:stable_24_20261112
  runner:            tools-harbor.wmcloud.org/toolforge/heroku-runner:stable_24_20261112
  latestBuilder:     tools-harbor.wmcloud.org/toolforge/heroku-builder:24_20261112
  latestRunner:      tools-harbor.wmcloud.org/toolforge/heroku-runner:24_20261112
  deprecatedBuilder: tools-harbor.wmcloud.org/toolforge/heroku-builder:22
  deprecatedRunner:  tools-harbor.wmcloud.org/toolforge/heroku-runner:22-cnb

  deprecatedValidUntil: 2026-04-27

certificates:
  internalClusterDomain: cluster.local

resources:
  limits:
    memory: ~
    cpu: ~
  requests:
    memory: ~
    cpu: ~

kubeVersion: ">=1.22"
