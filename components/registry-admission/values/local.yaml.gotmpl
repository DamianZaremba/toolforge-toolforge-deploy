# Update to your mr version tag
chartVersion: 0.0.81-20261022142203-99213fcb
chartRepository: toolsbeta
replicaCount: 1
allowedRegistries:
  - "registry.cloud.releng.team"
  - "docker-registry.svc.toolforge.org"
  - "docker-registry.tools.wmflabs.org"
  - "toolsbeta-harbor.wmcloud.org"
  - "tools-harbor.wmcloud.org"
  - "harbor.local"
disallowedImages:
  - "^docker-registry.tools.wmflabs.org/toolforge-php5-sssd-web:latest$"
  - "^docker-registry.tools.wmflabs.org/toolforge-php72-sssd-web:latest$"
  - "^docker-registry.tools.wmflabs.org/toolforge-php73-sssd-base:latest$"
  - "^docker-registry.tools.wmflabs.org/toolforge-php73-sssd-web:latest$"
  - "^docker-registry.tools.wmflabs.org/toolforge-php74-sssd-base:latest$"
  - "^docker-registry.tools.wmflabs.org/toolforge-php74-sssd-web:latest$"
  - "^docker-registry.tools.wmflabs.org/toolforge-php82-sssd-base:latest$"
  - "^docker-registry.tools.wmflabs.org/toolforge-php82-sssd-web:latest$"

excludedNamespaces:
  - "kube-system"
  - "foxtrot-ldap"
  - "local-path-storage"
  # This includes a Minio image for a local object storage service.
  # TODO: Is there a cleaner way of doing this? Deploy Minio to a separate
  # namespace?
  - "loki"
  - "infra-tracing-loki"

resources: ~
